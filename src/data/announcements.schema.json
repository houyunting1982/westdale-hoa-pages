{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "date", "summary"],
    "properties": {
      "id": { "type": "number" },
      "title": { "type": "string" },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "summary": { "type": "string" },
      "link": { "type": "string" }
    },
    "additionalProperties": false
  }
}
